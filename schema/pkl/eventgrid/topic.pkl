module azure.eventgrid.topic

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::EventGrid::Topic"
const apiVersion = "2021-12-01"

/// Schema the topic accepts on ingress. `CustomEventSchema` also needs an
/// inputSchemaMapping, which this plugin does not model, so prefer the other two.
typealias InputSchema = "EventGridSchema"|"CloudEventSchemaV1_0"|"CustomEventSchema"

typealias PublicNetworkAccess = "Enabled"|"Disabled"

/// Azure only supports `Allow` today; there is no deny action.
typealias IPActionType = "Allow"

/// An inbound IP firewall rule. Only meaningful when `publicNetworkAccess` is
/// `Enabled`. Order is significant — the plugin preserves the list as written.
@azure.SubResourceHint { apiVersion = module.apiVersion }
class InboundIPRule extends formae.SubResource {
    /// Single IP or CIDR, e.g. `"203.0.113.4"` or `"203.0.113.0/24"`.
    @azure.FieldHint { required = true }
    ipMask: String

    @azure.FieldHint { hasProviderDefault = true }
    action: IPActionType?
}

open class TopicResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: TopicResolvable = (this) {
        property = "id"
    }
    hidden name: TopicResolvable = (this) {
        property = "name"
    }
    /// Publish endpoint Azure assigned to this topic (read-only).
    hidden endpoint: TopicResolvable = (this) {
        property = "endpoint"
    }
}

/// An Event Grid custom topic — the ingress endpoint an application publishes its
/// own events to. Distinct from `AZURE::EventGrid::SystemTopic`, which wraps events
/// emitted by an Azure resource.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::Resources::ResourceGroup"
    listParam = new formae.ListProperty { parentProperty = "name" listParameter = "resourceGroupName" }
}
open class Topic extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 3 && length <= 50 && matches(Regex("^[a-zA-Z0-9-]+$")))

    @azure.FieldHint { required = true; createOnly = true }
    location: azure.Location

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    /// Immutable after creation.
    @azure.FieldHint { createOnly = true; hasProviderDefault = true }
    inputSchema: InputSchema?

    @azure.FieldHint { hasProviderDefault = true }
    publicNetworkAccess: PublicNetworkAccess?

    /// Disable SAS key auth, leaving Entra ID as the only way to publish.
    @azure.FieldHint { hasProviderDefault = true }
    disableLocalAuth: Boolean?

    @azure.FieldHint { }
    inboundIpRules: Listing<InboundIPRule>?

    @azure.FieldHint { outputField = "Tags"; updateMethod = "EntitySet"; indexField = "Key" }
    tags: Listing<azure.Tag>?

    hidden parent = this

    hidden res: TopicResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
