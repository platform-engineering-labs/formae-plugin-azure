module azure.eventgrid.eventsubscription

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::EventGrid::EventSubscription"
const apiVersion = "2022-06-15"

/// Where matching events are delivered: a Storage queue.
class StorageQueueDestination {
    /// ARM ID of the storage account holding the queue.
    @azure.FieldHint { required = true }
    storageAccountId: (String|formae.Resolvable)

    @azure.FieldHint { required = true }
    queueName: (String|formae.Resolvable)
}

/// Narrows which events are delivered. Omit to receive everything the topic emits.
class Filter {
    /// Only deliver events whose subject starts with this prefix.
    @azure.FieldHint { hasProviderDefault = true }
    subjectBeginsWith: String?

    @azure.FieldHint { hasProviderDefault = true }
    subjectEndsWith: String?

    /// Event types to deliver, e.g. "Microsoft.Storage.BlobCreated". Omit for all.
    @azure.FieldHint { hasProviderDefault = true }
    includedEventTypes: Listing<String>?
}

open class EventSubscriptionResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: EventSubscriptionResolvable = (this) {
        property = "id"
    }
    hidden name: EventSubscriptionResolvable = (this) {
        property = "name"
    }
}

/// An Event Grid event subscription — the delivery half of Event Grid. A topic
/// with no subscription accepts events and drops them.
///
/// This is a scoped extension resource, like a diagnostic setting: `scope` is the
/// ARM ID of whatever emits the events — an Event Grid topic or domain, a storage
/// account, a subscription, a resource group.
///
/// Only the Storage-queue destination is modelled. ARM's other endpoint types
/// (webhook, Event Hub, Service Bus queue/topic, Azure Function, hybrid
/// connection) are not, and the provider does not read them back either:
/// surfacing a destination the schema cannot express would show as drift forever.
/// A webhook destination in particular needs a live HTTPS endpoint that Event Grid
/// validates with a handshake at create time.
///
/// Dead-letter destinations, retry policy and advanced filters are likewise out of
/// scope for now.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
}
open class EventSubscription extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 3 && length <= 64 && matches(Regex("^[a-zA-Z0-9-]+$")))

    /// ARM ID of the event source this subscription hangs off.
    @azure.FieldHint { required = true; createOnly = true }
    scope: (String|formae.Resolvable)

    @azure.FieldHint { required = true }
    storageQueueDestination: StorageQueueDestination

    @azure.FieldHint { hasProviderDefault = true }
    filter: Filter?

    /// Delivery schema. `EventGridSchema` is the default; `CloudEventSchemaV1_0`
    /// emits CloudEvents 1.0. createOnly — ARM cannot change it in place.
    @azure.FieldHint { createOnly = true; hasProviderDefault = true }
    eventDeliverySchema: ("EventGridSchema"|"CloudEventSchemaV1_0"|"CustomInputSchema")?

    hidden parent = this

    hidden res: EventSubscriptionResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
