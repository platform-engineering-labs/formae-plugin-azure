module azure.datafactory.datafactorylinkedserviceblobstorage

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::DataFactory::LinkedServiceAzureBlobStorage"
const apiVersion = "2018-06-01"

/// Storage account kind, as Data Factory names it.
typealias AccountKind = "Storage"|"StorageV2"|"BlobStorage"|"BlockBlobStorage"

open class LinkedServiceAzureBlobStorageResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: LinkedServiceAzureBlobStorageResolvable = (this) {
        property = "id"
    }
    hidden name: LinkedServiceAzureBlobStorageResolvable = (this) {
        property = "name"
    }
}

/// An `AzureBlobStorage` linked service — how a factory reaches blob containers.
///
/// Two authentication shapes are expressible, and they are mutually exclusive:
///
///  - `serviceEndpoint` alone (e.g. `https://acct.blob.core.windows.net`) uses the
///    factory's managed identity. The factory needs a data role
///    ("Storage Blob Data Contributor") on the account. Prefer this: nothing
///    secret is stored anywhere.
///  - `connectionString` embeds an account key or SAS. It is sent as a
///    `SecureString`, so the service stores it encrypted and returns only a mask —
///    which is why it is declared `writeOnly` here: it can never be compared on
///    read, and drift in it cannot be detected. Changing it in a forma still
///    pushes the new value.
///
/// Creating a linked service is a metadata write and costs nothing.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::DataFactory::Factory"
    listParam = List(
        new formae.ListProperty { parentProperty = "name" listParameter = "factoryName" },
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" }
    )
}
open class LinkedServiceAzureBlobStorage extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 260 && matches(Regex("^[A-Za-z0-9_][A-Za-z0-9 _-]*$")))

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    factoryName: String(length >= 3 && length <= 63)|formae.Resolvable

    /// Blob service endpoint, e.g. `https://acct.blob.core.windows.net`. Mutually
    /// exclusive with `connectionString`.
    @azure.FieldHint { }
    serviceEndpoint: (String|formae.Resolvable)?

    /// Storage connection string carrying an account key or SAS. Write-only — see
    /// the note above.
    @azure.FieldHint { writeOnly = true }
    connectionString: (formae.Value|String|formae.SecretValue)?

    @azure.FieldHint { }
    accountKind: AccountKind?

    @azure.FieldHint { }
    description: String(length <= 1024)?

    /// Name of an integration runtime in the same factory to route through. Omit to
    /// use the factory's default AutoResolve runtime.
    @azure.FieldHint { }
    connectViaIntegrationRuntimeName: (String|formae.Resolvable)?

    /// Free-form labels the authoring UI shows against the linked service.
    /// Unrelated to ARM resource tags — a linked service is not an ARM tracked
    /// resource and cannot carry any.
    @azure.FieldHint { }
    annotations: Listing<String>?

    hidden parent = this

    hidden res: LinkedServiceAzureBlobStorageResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
