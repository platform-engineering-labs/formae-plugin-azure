module azure.datafactory.datafactorylinkedservicetablestorage

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::DataFactory::LinkedServiceAzureTableStorage"
const apiVersion = "2018-06-01"

open class LinkedServiceAzureTableStorageResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: LinkedServiceAzureTableStorageResolvable = (this) {
        property = "id"
    }
    hidden name: LinkedServiceAzureTableStorageResolvable = (this) {
        property = "name"
    }
}

/// An `AzureTableStorage` linked service — how a factory reaches table storage.
///
/// Unlike the blob linked service there is no managed-identity endpoint form: the
/// Table Storage connector authenticates through a connection string only. It is
/// sent as a `SecureString`, so the service stores it encrypted and returns only a
/// mask — which is why it is declared `writeOnly`: it can never be compared on
/// read, and drift in it cannot be detected. Changing it in a forma still pushes
/// the new value.
///
/// Creating a linked service is a metadata write and costs nothing.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::DataFactory::Factory"
    listParam = List(
        new formae.ListProperty { parentProperty = "name" listParameter = "factoryName" },
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" }
    )
}
open class LinkedServiceAzureTableStorage extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 260 && matches(Regex("^[A-Za-z0-9_][A-Za-z0-9 _-]*$")))

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    factoryName: String(length >= 3 && length <= 63)|formae.Resolvable

    /// Storage connection string, e.g.
    /// `DefaultEndpointsProtocol=https;AccountName=acct;EndpointSuffix=core.windows.net`.
    /// Write-only — see the note above.
    @azure.FieldHint { required = true; writeOnly = true }
    connectionString: (formae.Value|String|formae.SecretValue)

    @azure.FieldHint { }
    description: String(length <= 1024)?

    /// Name of an integration runtime in the same factory to route through. Omit to
    /// use the factory's default AutoResolve runtime.
    @azure.FieldHint { }
    connectViaIntegrationRuntimeName: (String|formae.Resolvable)?

    /// Free-form labels the authoring UI shows against the linked service.
    /// Unrelated to ARM resource tags — a linked service is not an ARM tracked
    /// resource and cannot carry any.
    @azure.FieldHint { }
    annotations: Listing<String>?

    hidden parent = this

    hidden res: LinkedServiceAzureTableStorageResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
