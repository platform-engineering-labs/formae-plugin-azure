module azure.policyinsights.policyremediation

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::PolicyInsights::PolicyRemediation"
const apiVersion = "2024-10-01"

open class PolicyRemediationResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: PolicyRemediationResolvable = (this) {
        property = "id"
    }
    hidden name: PolicyRemediationResolvable = (this) {
        property = "name"
    }
}

/// A remediation task: it walks the resources a policy assignment found
/// non-compliant under `scope` and applies the assignment's effect to them.
///
/// Free in itself — what the task deploys is not.
///
/// A REMEDIATION CHANGES EXISTING RESOURCES. It only does anything for an
/// assignment whose effect is `deployIfNotExists` or `modify`, and that assignment
/// needs a managed identity with enough RBAC to make the change. Against any other
/// effect the task is created and completes having touched nothing, which is why a
/// remediation for an `audit` assignment is a safe way to exercise the API.
///
/// It is a TASK, not a setting: it runs once when created. Re-writing this resource
/// re-runs it over whatever is non-compliant at that moment, and deleting it
/// removes the task record without undoing anything it did.
///
/// ARM's `filters` and `failureThreshold` objects are flattened here into
/// `filterLocations`, `filterResourceIds` and `failureThresholdPercentage` — they
/// hold one field each in practice, and flat fields are what the schema's
/// provider-default handling actually honours.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
}
open class PolicyRemediation extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 260)

    /// Where to remediate — a subscription, a resource group, a single resource, or
    /// a management group. Everything beneath it is in range.
    @azure.FieldHint { required = true; createOnly = true }
    scope: String(length >= 1)|formae.Resolvable

    /// ARM ID of the policy assignment whose findings are remediated.
    @azure.FieldHint { required = true }
    policyAssignmentId: (String|formae.Resolvable)

    /// Required when the assignment assigns an INITIATIVE: which definition inside
    /// it to remediate. Meaningless for a single-definition assignment.
    @azure.FieldHint { }
    policyDefinitionReferenceId: String?

    /// `ExistingNonCompliant` remediates what compliance already knows about.
    /// `ReEvaluateCompliance` re-scans first, which takes longer and cannot be
    /// combined with `filterResourceIds`.
    @azure.FieldHint { hasProviderDefault = true }
    resourceDiscoveryMode: ("ExistingNonCompliant"|"ReEvaluateCompliance")?

    /// How many resources to remediate at once. ARM picks a default when unset.
    @azure.FieldHint { hasProviderDefault = true }
    parallelDeployments: Int(this > 0)?

    /// Cap on how many resources the task may touch in total. ARM picks a default
    /// when unset.
    @azure.FieldHint { hasProviderDefault = true }
    resourceCount: Int(this > 0)?

    /// Fraction of failed deployments, 0.0 to 1.0, above which the task gives up.
    @azure.FieldHint { }
    failureThresholdPercentage: Float(this >= 0.0 && this <= 1.0)?

    /// Only remediate resources in these regions.
    @azure.FieldHint { }
    filterLocations: Listing<String>?

    /// Only remediate these resource IDs — at most 100, and not allowed together
    /// with `resourceDiscoveryMode = "ReEvaluateCompliance"`.
    @azure.FieldHint { }
    filterResourceIds: Listing<(String|formae.Resolvable)>?

    hidden parent = this

    hidden res: PolicyRemediationResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
