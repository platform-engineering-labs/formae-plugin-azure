module azure.apimanagement.apimanagementgateway

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::ApiManagement::Gateway"
const apiVersion = "2021-08-01"

open class GatewayResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: GatewayResolvable = (this) {
        property = "id"
    }
    hidden name: GatewayResolvable = (this) {
        property = "name"
    }
}

/// A self-hosted gateway registration — the record that lets a gateway
/// container running in your own datacentre or cluster attach itself to this
/// API Management instance.
///
/// This resource is only the registration. The container is deployed
/// separately, and it authenticates with a token minted from the gateway's
/// keys, which are deliberately not surfaced here: they are live credentials
/// and ARM returns them only from a separate list-keys call.
///
/// NOT AVAILABLE ON THE CONSUMPTION TIER. Self-hosted gateways need Developer
/// or Premium; on any other tier ARM rejects the create outright.
///
/// The location data is flattened into four scalars rather than modelled as
/// ARM's nested `locationData` object: only `locationDataName` is required, and
/// a service-populated field inside a nested class reads back as drift rather
/// than as a provider default.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::ApiManagement::Service"
    listParam = List(
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" },
        new formae.ListProperty { parentProperty = "name" listParameter = "serviceName" }
    )
}
open class Gateway extends formae.Resource {

    /// Gateway identifier, unique within the service. `managed` is reserved by
    /// ARM for the built-in gateway.
    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 80 && matches(Regex("^[^*#&+:<>?]+$")))

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    serviceName: String(length >= 1 && length <= 50)|formae.Resolvable

    /// Free-form name of where the gateway runs, e.g. a datacentre or cluster
    /// name. ARM requires it.
    @azure.FieldHint { required = true }
    locationDataName: String(length >= 1 && length <= 256)

    @azure.FieldHint { }
    locationDataCity: String(length <= 256)?

    @azure.FieldHint { }
    locationDataDistrict: String(length <= 256)?

    @azure.FieldHint { }
    locationDataCountryOrRegion: String(length <= 256)?

    @azure.FieldHint { }
    description: String?

    hidden parent = this

    hidden res: GatewayResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
