module azure.apimanagement.apimanagementproductpolicy

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::ApiManagement::ProductPolicy"
const apiVersion = "2021-08-01"

open class ProductPolicyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: ProductPolicyResolvable = (this) {
        property = "id"
    }
}

/// The policy attached to one product — applied to every API in the product,
/// after the service policy and before the API policy.
///
/// ARM models a policy as a singleton child named `policy`, so this resource
/// carries no `name` field: one policy per product.
///
/// ARM does not store the document verbatim. It reparses the XML and
/// re-serializes it, so indentation, line endings and attribute order all come
/// back changed, and `rawxml` comes back as `xml`. The provider therefore
/// reports the document you declared whenever it is semantically the same as
/// the one ARM holds, and reports ARM's own rendering only when the two
/// genuinely differ. This is the same treatment the service, API and operation
/// policies get — see `pkg/resources/apimanagementpolicybody.go`.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::ApiManagement::Product"
    listParam = List(
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" },
        new formae.ListProperty { parentProperty = "serviceName" listParameter = "serviceName" },
        new formae.ListProperty { parentProperty = "name" listParameter = "productName" }
    )
}
open class ProductPolicy extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    serviceName: String(length >= 1 && length <= 50)|formae.Resolvable

    /// Identifier of the product this policy belongs to — its ARM name, not its
    /// display name.
    @azure.FieldHint { required = true; createOnly = true }
    productName: String(length >= 1 && length <= 80)|formae.Resolvable

    /// The policy document. A product policy usually opens each section with
    /// `<base />` so the service policy still runs.
    @azure.FieldHint { required = true }
    value: String(length >= 1)

    /// See `AZURE::ApiManagement::Policy` for what the two formats mean and why
    /// `xml` is the lower-friction choice.
    @azure.FieldHint { hasProviderDefault = true }
    format: ("xml"|"rawxml")?

    hidden parent = this

    hidden res: ProductPolicyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
