module azure.relay.hybridconnectionauthorizationrule

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::Relay::HybridConnectionAuthorizationRule"
const apiVersion = "2021-11-01"

typealias AccessRight = "Listen"|"Send"|"Manage"

open class HybridConnectionAuthorizationRuleResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: HybridConnectionAuthorizationRuleResolvable = (this) {
        property = "id"
    }
    hidden name: HybridConnectionAuthorizationRuleResolvable = (this) {
        property = "name"
    }
}

/// A SAS rule scoped to a single Relay hybrid connection.
///
/// Prefer this over a namespace-wide rule when handing credentials to one
/// listener or sender: the keys it mints reach only this connection. The keys and
/// connection strings are NOT surfaced as properties — ARM returns them only from
/// a separate ListKeys call, so exposing them would persist live credentials in
/// resource state.
///
/// `Manage` implies both `Send` and `Listen`, and ARM rejects a rule that asks
/// for `Manage` without them.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::Relay::HybridConnection"
    listParam = List(
        new formae.ListProperty { parentProperty = "name" listParameter = "hybridConnectionName" },
        new formae.ListProperty { parentProperty = "namespaceName" listParameter = "namespaceName" },
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" }
    )
}
open class HybridConnectionAuthorizationRule extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 50)

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    namespaceName: String(length >= 6 && length <= 50)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    hybridConnectionName: String(length >= 1 && length <= 260)|formae.Resolvable

    /// The rights granted. This is the rule's only mutable property, so it is also
    /// the only thing an update can change.
    @azure.FieldHint { required = true }
    rights: Listing<AccessRight>

    hidden parent = this

    hidden res: HybridConnectionAuthorizationRuleResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
