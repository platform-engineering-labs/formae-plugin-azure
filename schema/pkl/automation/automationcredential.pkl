module azure.automation.automationcredential

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::Automation::Credential"
const apiVersion = "2024-10-23"

open class AutomationCredentialResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: AutomationCredentialResolvable = (this) {
        property = "id"
    }
    hidden name: AutomationCredentialResolvable = (this) {
        property = "name"
    }
    /// The stored username. The password has no resolvable: it is write-only.
    hidden userName: AutomationCredentialResolvable = (this) {
        property = "userName"
    }
}

/// A credential asset in an Azure Automation account — a username/password pair a
/// runbook retrieves at execution time with Get-AutomationPSCredential.
///
/// `password` is WRITE-ONLY by ARM's own design: the credential response model
/// carries no password field at all, so Get can never return one. Drift in the
/// password therefore cannot be detected — changing it in a forma still pushes
/// the new value.
///
/// The username IS returned and is fully comparable.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::Automation::Account"
    listParam = List(
        new formae.ListProperty { parentProperty = "name" listParameter = "automationAccountName" },
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" }
    )
}
open class AutomationCredential extends formae.Resource {

    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 128)

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    automationAccountName: String(length >= 6 && length <= 50)|formae.Resolvable

    @azure.FieldHint { required = true }
    userName: String(length >= 1)

    /// The password. Write-only — see the note above. Wrap it in
    /// `formae.value(...).opaque` to keep the plaintext out of stored state.
    @azure.FieldHint { required = true; writeOnly = true }
    password: (formae.Value|String)

    @azure.FieldHint { }
    description: String(length <= 512)?

    hidden parent = this

    hidden res: AutomationCredentialResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
