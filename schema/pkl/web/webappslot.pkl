module azure.web.webappslot

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::Web::WebAppSlot"
const apiVersion = "2025-03-01"

open class WebAppSlotResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: WebAppSlotResolvable = (this) {
        property = "id"
    }
    hidden name: WebAppSlotResolvable = (this) {
        property = "name"
    }
    hidden defaultHostName: WebAppSlotResolvable = (this) {
        property = "defaultHostName"
    }
}

/// State of the FTP / FTPS publishing endpoint.
typealias FtpsState = "AllAllowed"|"FtpsOnly"|"Disabled"

/// Minimum TLS version accepted for inbound HTTPS.
typealias TLSVersion = "1.0"|"1.1"|"1.2"|"1.3"

/// An app setting. Values are write-only — see `WebAppSlot.appSettings`.
@azure.SubResourceHint { apiVersion = module.apiVersion }
class AppSetting extends formae.SubResource {
    @azure.FieldHint { }
    name: String(length >= 1)

    /// Setting value. Accepts a literal, a reference to another resource's output,
    /// or `formae.value(...).opaque` for a secret.
    @azure.FieldHint { }
    value: (formae.Value|String|formae.Resolvable)
}

/// Slot site configuration (`Microsoft.Web/sites/{site}/slots/{slot}/config/web`).
///
/// Azure returns a value for every one of these whether or not the create body set
/// it, and the conformance framework does not honour `hasProviderDefault` on fields
/// of a nested class — only on top-level resource fields. Set the ones that apply
/// explicitly; a forma that omits them will show drift once Azure fills in its own
/// default.
@azure.SubResourceHint { apiVersion = module.apiVersion }
class SlotSiteConfig extends formae.SubResource {
    /// Linux runtime stack, e.g. `PYTHON|3.12`. Must match the parent app's plan.
    @azure.FieldHint { }
    linuxFxVersion: String?

    /// .NET Framework version for a Windows slot, e.g. `v8.0`.
    @azure.FieldHint { }
    netFrameworkVersion: String?

    /// Keep the slot warm. Not available on Free/Shared plans.
    @azure.FieldHint { }
    alwaysOn: Boolean?

    /// FTP / FTPS publishing state.
    @azure.FieldHint { }
    ftpsState: FtpsState?

    /// Minimum inbound TLS version.
    @azure.FieldHint { }
    minTlsVersion: TLSVersion?

    /// Allow clients to connect over HTTP/2.
    @azure.FieldHint { }
    http20Enabled: Boolean?

    /// Path the platform probes for health.
    @azure.FieldHint { }
    healthCheckPath: String?
}

/// A deployment slot under an App Service app
/// (`Microsoft.Web/sites/{site}/slots/{slot}`).
///
/// Slots need a Standard tier plan or better — Free, Shared and Basic plans have no
/// slots, and ARM rejects the create.
///
/// `siteConfig` is fetched with a second ARM call on read, and `appSettings` is
/// write-only, for the same reasons as on `AZURE::Web::WebApp`.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::Web::WebApp"
    listParam = List(
        new formae.ListProperty { parentProperty = "name" listParameter = "siteName" },
        new formae.ListProperty { parentProperty = "resourceGroupName" listParameter = "resourceGroupName" }
    )
}
open class WebAppSlot extends formae.Resource {

    /// Slot name. The slot is served at `<site>-<name>.azurewebsites.net`.
    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 1 && length <= 59)

    /// Name of the parent app, e.g. `app.res.name`.
    @azure.FieldHint { required = true; createOnly = true }
    siteName: String|formae.Resolvable

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    /// Must match the parent app's region.
    @azure.FieldHint { required = true; createOnly = true }
    location: azure.Location

    /// ARM ID of the App Service plan the slot runs on. Defaults to the parent
    /// app's plan when omitted.
    @azure.FieldHint { hasProviderDefault = true }
    serverFarmId: (String|formae.Resolvable)?

    /// Resource kind, mirroring the parent app, e.g. `app,linux`. Immutable.
    @azure.FieldHint { createOnly = true; hasProviderDefault = true }
    kind: String?

    /// Redirect every HTTP request to HTTPS.
    @azure.FieldHint { hasProviderDefault = true }
    httpsOnly: Boolean?

    @azure.FieldHint { hasProviderDefault = true }
    siteConfig: SlotSiteConfig?

    /// Slot application settings. Write-only: sent on every write, never read back.
    @azure.FieldHint { writeOnly = true }
    appSettings: Listing<AppSetting>?

    @azure.FieldHint { outputField = "Tags"; updateMethod = "EntitySet"; indexField = "Key" }
    tags: Listing<azure.Tag>?

    /// Read-only output: the slot's default hostname.
    @azure.FieldHint { hasProviderDefault = true }
    defaultHostName: String?

    hidden parent = this

    hidden res: WebAppSlotResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
