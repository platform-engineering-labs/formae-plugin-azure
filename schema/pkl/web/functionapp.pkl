module azure.web.functionapp

import "@formae/formae.pkl"
import "../azure.pkl"

const type = "AZURE::Web::FunctionApp"
const apiVersion = "2025-03-01"

open class FunctionAppResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: FunctionAppResolvable = (this) {
        property = "id"
    }
    hidden name: FunctionAppResolvable = (this) {
        property = "name"
    }
    hidden defaultHostName: FunctionAppResolvable = (this) {
        property = "defaultHostName"
    }
}

/// State of the FTP / FTPS publishing endpoint.
typealias FtpsState = "AllAllowed"|"FtpsOnly"|"Disabled"

/// Minimum TLS version accepted for inbound HTTPS.
typealias TLSVersion = "1.0"|"1.1"|"1.2"|"1.3"

/// Whether public network traffic reaches the app.
typealias PublicNetworkAccess = "Enabled"|"Disabled"

/// Managed identity type.
typealias IdentityType = "SystemAssigned"|"UserAssigned"|"SystemAssigned, UserAssigned"|"None"

/// Resource kind. ARM stores function apps under `Microsoft.Web/sites` and tells
/// them apart from web apps by this field, so it always carries `functionapp`.
typealias FunctionAppKind = "functionapp"|"functionapp,linux"|"functionapp,linux,container"|"functionapp,workflowapp"

/// Managed service identity for the function app.
class FunctionAppIdentity {
    /// Identity type.
    @azure.FieldHint { }
    type: IdentityType

    /// ARM IDs of user-assigned identities to attach. Required when `type`
    /// includes `UserAssigned`.
    @azure.FieldHint { }
    userAssignedIdentityIds: Listing<String|formae.Resolvable>?
}

/// An app setting. Values are write-only — see `FunctionApp.appSettings`.
class AppSetting {
    @azure.FieldHint { }
    name: String(length >= 1)

    /// Setting value. Accepts a literal, a reference to another resource's output,
    /// or `formae.value(...).opaque` for a secret.
    @azure.FieldHint { }
    value: (formae.Value|String|formae.Resolvable)
}

/// Site configuration (`Microsoft.Web/sites/config/web`).
///
/// Azure returns a value for every one of these whether or not the create body set
/// it, and the conformance framework does not honour `hasProviderDefault` on fields
/// of a nested class — only on top-level resource fields. Set the ones that apply
/// to your runtime explicitly; a forma that omits them will show drift once Azure
/// fills in its own default.
class FunctionSiteConfig {
    /// Linux runtime stack, e.g. `PYTHON|3.12`, `NODE|20`, `DOTNET-ISOLATED|8.0`.
    /// Linux plans only (`ServicePlan.reserved = true`).
    @azure.FieldHint { }
    linuxFxVersion: String?

    /// Windows container image, e.g. `DOCKER|<image>`. Windows plans only.
    @azure.FieldHint { }
    windowsFxVersion: String?

    /// .NET Framework version for a Windows function app, e.g. `v8.0`.
    @azure.FieldHint { }
    netFrameworkVersion: String?

    /// Keep the app warm. Not available on Consumption (`Y1`) plans.
    @azure.FieldHint { }
    alwaysOn: Boolean?

    /// FTP / FTPS publishing state.
    @azure.FieldHint { }
    ftpsState: FtpsState?

    /// Minimum inbound TLS version.
    @azure.FieldHint { }
    minTlsVersion: TLSVersion?

    /// Allow clients to connect over HTTP/2.
    @azure.FieldHint { }
    http20Enabled: Boolean?

    /// Path the platform probes for health, e.g. `/api/health`.
    @azure.FieldHint { }
    healthCheckPath: String?

    /// Maximum number of instances the runtime scales out to. Consumption and
    /// Elastic Premium plans only; `0` means unbounded.
    @azure.FieldHint { }
    functionAppScaleLimit: Int(this >= 0)?
}

/// An Azure Functions app (`Microsoft.Web/sites` with a `functionapp` kind).
///
/// Same ARM type as `AZURE::Web::WebApp`, kept as its own formae type because the
/// function-specific surface (`kind`, `functionAppScaleLimit`, the mandatory
/// storage-account app settings) is what makes it a function app. Discovery of the
/// two types is disjoint: this type only enumerates sites whose `kind` carries
/// `functionapp`, and WebApp only enumerates the ones that do not.
///
/// A function app needs storage. Supply at minimum, via `appSettings`:
///   * `AzureWebJobsStorage` — connection string for the storage account
///   * `FUNCTIONS_EXTENSION_VERSION` — e.g. `~4`
///   * `FUNCTIONS_WORKER_RUNTIME` — e.g. `python`, `node`, `dotnet-isolated`
///
/// `appSettings` is write-only for the same reasons as on `AZURE::Web::WebApp`:
/// they are sent on every write and never read back, so drift in them cannot be
/// detected.
@azure.ResourceHint {
    type = module.type
    identifier = "id"
    apiVersion = module.apiVersion
    parent = "AZURE::Resources::ResourceGroup"
    listParam = new formae.ListProperty { parentProperty = "name" listParameter = "resourceGroupName" }
}
open class FunctionApp extends formae.Resource {

    /// Globally unique: it becomes `<name>.azurewebsites.net`.
    @azure.FieldHint { required = true; createOnly = true }
    name: String(length >= 2 && length <= 60)

    @azure.FieldHint { required = true; createOnly = true }
    location: azure.Location

    @azure.FieldHint { required = true; createOnly = true }
    resourceGroupName: String(length >= 1 && length <= 90)|formae.Resolvable

    /// ARM ID of the App Service plan to run on, e.g. `plan.res.id`.
    @azure.FieldHint { required = true }
    serverFarmId: String|formae.Resolvable

    /// Immutable. Defaults to `functionapp` (Windows); use `functionapp,linux` on a
    /// Linux plan.
    @azure.FieldHint { createOnly = true; hasProviderDefault = true }
    kind: FunctionAppKind?

    /// Redirect every HTTP request to HTTPS.
    @azure.FieldHint { hasProviderDefault = true }
    httpsOnly: Boolean?

    /// Send ARR session-affinity cookies.
    @azure.FieldHint { hasProviderDefault = true }
    clientAffinityEnabled: Boolean?

    @azure.FieldHint { hasProviderDefault = true }
    publicNetworkAccess: PublicNetworkAccess?

    /// ARM ID of the subnet to join for regional VNet integration. The subnet must
    /// be delegated to `Microsoft.Web/serverFarms`.
    @azure.FieldHint { }
    virtualNetworkSubnetId: (String|formae.Resolvable)?

    @azure.FieldHint { hasProviderDefault = true }
    siteConfig: FunctionSiteConfig?

    /// Application settings. Write-only: sent on every write, never read back.
    @azure.FieldHint { writeOnly = true }
    appSettings: Listing<AppSetting>?

    @azure.FieldHint { }
    identity: FunctionAppIdentity?

    @azure.FieldHint { outputField = "Tags"; updateMethod = "EntitySet"; indexField = "Key" }
    tags: Listing<azure.Tag>?

    /// Read-only output: the app's default hostname.
    @azure.FieldHint { hasProviderDefault = true }
    defaultHostName: String?

    hidden parent = this

    hidden res: FunctionAppResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
