amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/servicebus/servicebusnamespace.pkl" as namespace
import "@azure/servicebus/servicebusauthorizationrule.pkl" as authrule
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "service-bus-authrule-test-rg"
  name = "formae-plugin-sdk-test-sbar-rg-\(vars.testRunID)"
  location = "eastus"
}

local namespaceSku = new namespace.NamespaceSKU {
  name = "Standard"
}

local ns = new namespace.Namespace {
  label = "service-bus-authrule-test-ns"
  name = "fpsdt-sbar-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = namespaceSku
}

forma {
  vars.stack

  vars.target

  rg

  ns

  // A least-privilege application policy. The implicit RootManageSharedAccessKey
  // rule that Azure creates with every namespace is filtered out of discovery.
  new authrule.AuthorizationRule {
    label = "plugin-sdk-test-service-bus-authrule"
    name = "fpsdt-app-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    namespaceName = ns.res.name
    rights = new Listing { "Listen" }
  }
}
