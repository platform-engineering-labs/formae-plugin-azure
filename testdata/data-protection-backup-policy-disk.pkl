amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/dataprotection/backupvault.pkl" as bv
import "@azure/dataprotection/dataprotectionbackuppolicydisk.pkl" as bp
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "bp-disk-test-rg"
  name = "formae-plugin-sdk-test-bp-disk-rg-\(vars.testRunID)"
  location = "eastus"
}

// The cheapest vault that can hold a policy: one LocallyRedundant VaultStore and
// soft delete off, so the destroy phase is clean. A policy is a record inside the
// vault and adds nothing to its cost.
local backupVault = new bv.BackupVault {
  label = "bp-disk-test-vault"
  name = "fpsdt-bpdisk-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  storageSettings = new Listing {
    new bv.StorageSetting {
      datastoreType = "VaultStore"
      type = "LocallyRedundant"
    }
  }
  softDeleteState = "Off"
}

forma {
  vars.stack

  vars.target

  rg

  backupVault

  // Disk backup is snapshot-based, so both tiers are OperationalStore.
  new bp.BackupPolicyDisk {
    label = "plugin-sdk-test-bp-disk"
    name = "fpsdt-bpdisk-pol-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    vaultName = backupVault.res.name
    backupRules = new Listing {
      new bp.BackupRule {
        name = "BackupHourly"
        backupType = "Incremental"
        datastoreType = "OperationalStore"
        // Every four hours from 13:00 UTC. timeZone is deliberately left unset:
        // ARM's own disk template omits it and fills in UTC.
        repeatingTimeIntervals = new Listing { "R/2024-01-01T13:00:00+00:00/PT4H" }
        taggingCriteria = new Listing {
          new bp.TaggingCriterion {
            tagName = "Default"
            isDefault = true
            taggingPriority = 99
          }
        }
      }
    }
    retentionRules = new Listing {
      new bp.RetentionRule {
        name = "Default"
        isDefault = true
        lifecycles = new Listing {
          new bp.RetentionLifecycle {
            sourceDatastoreType = "OperationalStore"
            deleteAfterDuration = "P7D"
          }
        }
      }
    }
  }
}
