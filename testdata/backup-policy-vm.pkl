amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/recoveryservices/backuppolicyvm.pkl" as bpvm
import "@azure/resources/resourcegroup.pkl"
import "@azure/recoveryservices/recoveryservicesvault.pkl" as rsv
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "vmpol-test-rg"
  name = "formae-plugin-sdk-test-vmpol-rg-\(vars.testRunID)"
  location = "eastus"
}

// The policy needs its own vault. Soft delete stays off so the teardown does not
// have to wait out a retention window.
local vault = new rsv.Vault {
  label = "vmpol-test-vault"
  name = "fpsdt-vmpol-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  skuName = "Standard"
  softDeleteState = "Disabled"
}

forma {
  vars.stack

  vars.target

  rg

  vault

  // Daily at 23:00 UTC, kept for a week. ARM's floor for V1 daily retention is
  // 7 days; the retention times are derived from the schedule times by the
  // plugin because ARM rejects a policy whose two sets differ.
  new bpvm.BackupPolicyVM {
    label = "plugin-sdk-test-backup-policy-vm"
    name = "fpsdt-vmpol-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    vaultName = vault.res.name
    timeZone = "UTC"
    instantRpRetentionRangeInDays = 2
    backupSchedule = new bpvm.BackupSchedule {
      frequency = "Daily"
      times = new Listing { "23:00" }
    }
    dailyRetention = new bpvm.DailyRetention {
      count = 7
    }
  }
}
