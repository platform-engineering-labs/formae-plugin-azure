amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementproduct.pkl" as apimproduct
import "@azure/apimanagement/apimanagementsubscription.pkl" as apimsub
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-sub-test-rg"
  name = "formae-plugin-sdk-test-apimsub-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing.
//
// NOTE: this fixture cannot pass on Consumption. The published service limits
// give the maximum number of subscriptions on Consumption as `N/A`
// (learn.microsoft.com/azure/api-management/service-limits) — the tier has no
// subscription store, which is also why every other APIM fixture here declares
// its products with subscriptionRequired = false. Handler, schema and test are
// complete; the SKU is deliberately not changed.
local svc = new apim.Service {
  label = "apim-sub-test-service"
  name = "fpsdt-apimsub-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

// The subscription's scope. subscriptionRequired is true here — unlike every
// other product fixture in this suite — because a subscription against an open
// product would issue keys nothing checks.
local product = new apimproduct.Product {
  label = "apim-sub-test-product"
  name = "conformance-product"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  displayName = "Conformance Product"
  subscriptionRequired = true
  approvalRequired = false
  state = "published"
}

forma {
  vars.stack

  vars.target

  rg
  svc
  product

  // Update: display name and state change, and tracing is turned on. `scope`
  // stays put — repointing a subscription at a different product is a change of
  // what the keys unlock, not a rename, and is not what this phase tests.
  new apimsub.Subscription {
    label = "plugin-sdk-test-apim-subscription"
    name = "conformance-subscription"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    displayName = "Conformance Subscription v2"
    scope = product.res.id
    state = "suspended"
    allowTracing = true
  }
}
