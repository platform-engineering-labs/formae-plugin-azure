amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/dataprotection/resourceguard.pkl" as guard
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "guard-test-rg"
  name = "formae-plugin-sdk-test-guard-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // A guard with nothing bound to it is inert - binding it to a vault is a
  // separate backupResourceGuardProxies sub-resource - so this is safe to create
  // and destroy without stranding any vault behind multi-user authorization.
  new guard.ResourceGuard {
    label = "plugin-sdk-test-resource-guard"
    name = "fpsdt-guard-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    vaultCriticalOperationExclusionList = new Listing {
      "Microsoft.RecoveryServices/vaults/backupconfig/write"
    }
  }
}
