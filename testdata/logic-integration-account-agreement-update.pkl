amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/logic/logicintegrationaccount.pkl" as logicaccount
import "@azure/logic/logicintegrationaccountpartner.pkl" as logicpartner
import "@azure/logic/logicintegrationaccountagreement.pkl" as logicagreement
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "logicagr-test-rg"
  name = "formae-plugin-sdk-test-logicagr-rg-\(vars.testRunID)"
  location = "centralus"
}

// centralus: one Free integration account per region per subscription, and the
// other fixtures in this group each own a different one.
local iaccount = new logicaccount.IntegrationAccount {
  label = "logicagr-test-account"
  name = "fpsdt-logicagr-\(vars.testRunID)"
  location = "centralus"
  resourceGroupName = rg.res.name
  skuName = "Free"
}

// The locals are hostTradingPartner / guestTradingPartner, NOT hostPartner /
// guestPartner: a local that shares its name with a property of the class it is
// assigned to resolves to the PROPERTY, so `hostPartner = hostPartner.res.name`
// self-references and Pkl blows the stack ~6000 frames deep with no useful
// message.
//
// ORDER MATTERS. ARM rejects an agreement whose host or guest partner does not
// already exist, and it matches each on BOTH qualifier and value — the pairs
// below are reproduced exactly in hostIdentity/guestIdentity and again inside
// the AS2 content. Referencing the partners through res.name is what makes
// formae create them first.
local hostTradingPartner = new logicpartner.IntegrationAccountPartner {
  label = "logicagr-test-host-partner"
  name = "conformance-host"
  resourceGroupName = rg.res.name
  integrationAccountName = iaccount.res.name
  partnerType = "B2B"
  businessIdentities = new Listing {
    new logicpartner.BusinessIdentity {
      qualifier = "AS2Identity"
      value = "FORMAE-HOST"
    }
  }
}

local guestTradingPartner = new logicpartner.IntegrationAccountPartner {
  label = "logicagr-test-guest-partner"
  name = "conformance-guest"
  resourceGroupName = rg.res.name
  integrationAccountName = iaccount.res.name
  partnerType = "B2B"
  businessIdentities = new Listing {
    new logicpartner.BusinessIdentity {
      qualifier = "AS2Identity"
      value = "FORMAE-GUEST"
    }
  }
}

forma {
  vars.stack

  vars.target

  rg
  iaccount
  hostTradingPartner
  guestTradingPartner

  // Update: the MDN MIC hashing algorithm moves from NotSpecified to SHA2256.
  // The whole settings block is re-PUT because an agreement has no PATCH verb,
  // and the partners and identities are unchanged — changing either would be a
  // different agreement, not an update to this one. `content` is write-only, so
  // this change is pushed but not verified by reading it back.
  new logicagreement.IntegrationAccountAgreement {
    label = "plugin-sdk-test-logic-integration-account-agreement"
    name = "conformance-as2-agreement"
    resourceGroupName = rg.res.name
    integrationAccountName = iaccount.res.name
    agreementType = "AS2"
    hostPartner = hostTradingPartner.res.name
    guestPartner = guestTradingPartner.res.name
    hostIdentity = new logicagreement.BusinessIdentity {
      qualifier = "AS2Identity"
      value = "FORMAE-HOST"
    }
    guestIdentity = new logicagreement.BusinessIdentity {
      qualifier = "AS2Identity"
      value = "FORMAE-GUEST"
    }
    content = #"{"receiveAgreement":{"protocolSettings":{"acknowledgementConnectionSettings":{"ignoreCertificateNameMismatch":false,"keepHttpConnectionAlive":true,"supportHttpStatusCodeContinue":true,"unfoldHttpHeaders":true},"envelopeSettings":{"autogenerateFileName":false,"fileNameTemplate":"%MessageID%.txt","messageContentType":"text/plain","suspendMessageOnFileNameGenerationError":true,"transmitFileNameInMimeHeader":true},"errorSettings":{"resendIfMDNNotReceived":false,"suspendDuplicateMessage":false},"mdnSettings":{"micHashingAlgorithm":"SHA2256","needMDN":false,"sendInboundMDNToMessageBox":false,"sendMDNAsynchronously":false,"signMDN":false,"signOutboundMDNIfOptional":false},"messageConnectionSettings":{"ignoreCertificateNameMismatch":false,"keepHttpConnectionAlive":true,"supportHttpStatusCodeContinue":true,"unfoldHttpHeaders":true},"securitySettings":{"enableNRRForInboundDecodedMessages":false,"enableNRRForInboundEncodedMessages":false,"enableNRRForInboundMDN":false,"enableNRRForOutboundDecodedMessages":false,"enableNRRForOutboundEncodedMessages":false,"enableNRRForOutboundMDN":false,"overrideGroupSigningCertificate":false},"validationSettings":{"checkCertificateRevocationListOnReceive":false,"checkCertificateRevocationListOnSend":false,"checkDuplicateMessage":false,"compressMessage":false,"encryptMessage":false,"encryptionAlgorithm":"NotSpecified","interchangeDuplicatesValidityDays":5,"overrideMessageProperties":false,"signMessage":false}},"receiverBusinessIdentity":{"qualifier":"AS2Identity","value":"FORMAE-HOST"},"senderBusinessIdentity":{"qualifier":"AS2Identity","value":"FORMAE-GUEST"}},"sendAgreement":{"protocolSettings":{"acknowledgementConnectionSettings":{"ignoreCertificateNameMismatch":false,"keepHttpConnectionAlive":true,"supportHttpStatusCodeContinue":true,"unfoldHttpHeaders":true},"envelopeSettings":{"autogenerateFileName":false,"fileNameTemplate":"%MessageID%.txt","messageContentType":"text/plain","suspendMessageOnFileNameGenerationError":true,"transmitFileNameInMimeHeader":true},"errorSettings":{"resendIfMDNNotReceived":false,"suspendDuplicateMessage":false},"mdnSettings":{"micHashingAlgorithm":"SHA2256","needMDN":false,"sendInboundMDNToMessageBox":false,"sendMDNAsynchronously":false,"signMDN":false,"signOutboundMDNIfOptional":false},"messageConnectionSettings":{"ignoreCertificateNameMismatch":false,"keepHttpConnectionAlive":true,"supportHttpStatusCodeContinue":true,"unfoldHttpHeaders":true},"securitySettings":{"enableNRRForInboundDecodedMessages":false,"enableNRRForInboundEncodedMessages":false,"enableNRRForInboundMDN":false,"enableNRRForOutboundDecodedMessages":false,"enableNRRForOutboundEncodedMessages":false,"enableNRRForOutboundMDN":false,"overrideGroupSigningCertificate":false},"validationSettings":{"checkCertificateRevocationListOnReceive":false,"checkCertificateRevocationListOnSend":false,"checkDuplicateMessage":false,"compressMessage":false,"encryptMessage":false,"encryptionAlgorithm":"NotSpecified","interchangeDuplicatesValidityDays":5,"overrideMessageProperties":false,"signMessage":false}},"receiverBusinessIdentity":{"qualifier":"AS2Identity","value":"FORMAE-GUEST"},"senderBusinessIdentity":{"qualifier":"AS2Identity","value":"FORMAE-HOST"}}}"#
  }
}
