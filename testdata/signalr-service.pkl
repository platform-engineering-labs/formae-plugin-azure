amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/signalrservice/signalr.pkl" as sigr
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "signalr-test-rg"
  name = "formae-plugin-sdk-test-signalr-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // Standard_S1 rather than Free_F1: the free tier is limited to one instance per
  // subscription per region, which would collide across conformance runs.
  new sigr.SignalR {
    label = "plugin-sdk-test-signalr"
    name = "fpsdt-signalr-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    sku = new sigr.SKU {
      name = "Standard_S1"
      capacity = 1
    }
    kind = "SignalR"
    serviceMode = "Default"
    publicNetworkAccess = "Enabled"
  }
}
