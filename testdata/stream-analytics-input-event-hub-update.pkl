amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/eventhub/eventhubnamespace.pkl"
import "@azure/eventhub/eventhub.pkl"
import "@azure/streamanalytics/streamanalyticsjob.pkl" as sajob
import "@azure/streamanalytics/streamanalyticsinputeventhub.pkl" as sainput
import "vars.pkl"

// The datasource credential below is a placeholder, not a real key.
//
// ARM accepts any string here and never returns it (the field is writeOnly in the
// schema for exactly that reason), and Stream Analytics validates a datasource only
// when the job starts or when the separate Test operation is called. The job this
// fixture creates is never started, so no connection is ever attempted. There is
// also no way to obtain a real key from a forma: this plugin deliberately does not
// surface storage account keys or SAS policy keys as properties, since that would
// persist live credentials in resource state.

local rg = new resourcegroup.ResourceGroup {
  label = "asa-input-eh-test-rg"
  name = "formae-plugin-sdk-test-asaieh-rg-\(vars.testRunID)"
  location = "eastus"
}

local ehNamespace = new eventhubnamespace.Namespace {
  label = "asa-input-eh-test-eh-ns"
  name = "fpsdt-asa-ieh-ns-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new eventhubnamespace.NamespaceSKU {
    name = "Standard"
    capacity = 1
  }
}

local hub = new eventhub.EventHub {
  label = "asa-input-eh-test-eh"
  name = "fpsdt-asa-ieh-hub-\(vars.testRunID)"
  resourceGroupName = rg.res.name
  namespaceName = ehNamespace.res.name
  partitionCount = 2
  messageRetentionInDays = 1
}

// Provisioned stopped and left that way: Start/Stop is a separate ARM verb pair,
// and a running job bills streaming units per hour.
local job = new sajob.StreamingJob {
  label = "asa-input-eh-test-job"
  name = "fpsdt-asa-ieh-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new sajob.StreamingJobSKU { name = "Standard" }
  jobType = "Cloud"
  compatibilityLevel = "1.2"
  dataLocale = "en-US"
  eventsLateArrivalMaxDelayInSeconds = 5
  eventsOutOfOrderMaxDelayInSeconds = 0
  eventsOutOfOrderPolicy = "Adjust"
  outputErrorPolicy = "Stop"
  transformation = new sajob.JobTransformation {
    name = "Transformation"
    query = "SELECT * INTO [asaoutput] FROM [asainput]"
    streamingUnits = 3
  }
}

forma {
  vars.stack

  vars.target

  rg
  ehNamespace
  hub
  job

  // RootManageSharedAccessKey is the policy every Event Hubs namespace ships with;
  // it carries Listen, which is what an input needs.
  new sainput.InputEventHub {
    label = "plugin-sdk-test-stream-analytics-input-event-hub"
    name = "asainput"
    resourceGroupName = rg.res.name
    jobName = job.res.name
    serviceBusNamespace = ehNamespace.res.name
    eventHubName = hub.res.name
    sharedAccessPolicyName = "RootManageSharedAccessKey"
    sharedAccessPolicyKey = "Zm9ybWFlLWNvbmZvcm1hbmNlLXBsYWNlaG9sZGVyISE="
    // Update: repartition the stream on a different column. In-place PATCH.
    partitionKey = "sensorId"
    serialization = new sainput.EventHubInputSerialization {
      type = "Json"
      encoding = "UTF8"
    }
  }
}
