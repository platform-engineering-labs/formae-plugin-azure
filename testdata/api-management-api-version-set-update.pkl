amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementapiversionset.pkl" as apimvs
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-vs-test-rg"
  name = "formae-plugin-sdk-test-apimvs-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing.
local svc = new apim.Service {
  label = "apim-vs-test-service"
  name = "fpsdt-apimvs-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

forma {
  vars.stack

  vars.target

  rg
  svc

  // Update: rename and redescribe. The versioning scheme is left alone -
  // switching it would invalidate every version already published under it.
  new apimvs.ApiVersionSet {
    label = "plugin-sdk-test-apim-api-version-set"
    name = "conformance-versions"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    displayName = "Conformance API versions v2"
    versioningScheme = "Segment"
    description = "Version set for the conformance API, redescribed"
  }
}
