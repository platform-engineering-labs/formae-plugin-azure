amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/web/serviceplan.pkl"

import "vars.pkl"

// Update: turn on per-site scaling. In-place property change on the same plan, so
// the NativeID stays the same. kind, reserved and the SKU are left alone — kind and
// reserved are createOnly, and changing the SKU tier is what a replace would look
// like rather than an update.

local rg = new resourcegroup.ResourceGroup {
  label = "asp-test-rg"
  name = "formae-plugin-sdk-test-asp-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new serviceplan.ServicePlan {
    label = "plugin-sdk-test-app-service-plan"
    name = "fpsdt-asp-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    kind = "linux"
    reserved = true
    sku = new serviceplan.ServicePlanSKU {
      name = "B1"
      tier = "Basic"
      capacity = 1
    }
    // Update: apps on this plan now scale independently of one another.
    perSiteScaling = true
  }
}
