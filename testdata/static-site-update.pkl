amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/web/staticsite.pkl"

import "vars.pkl"

// Update: forbid pull-request staging environments and lock the config file. Both are
// in-place property changes on the same site, so the NativeID stays the same. name,
// location and resourceGroupName are createOnly and are untouched.

local rg = new resourcegroup.ResourceGroup {
  label = "static-site-test-rg"
  name = "formae-plugin-sdk-test-swa-rg-\(vars.testRunID)"
  location = "eastus2"
}

forma {
  vars.stack

  vars.target

  rg

  new staticsite.StaticSite {
    label = "plugin-sdk-test-static-site"
    name = "fpsdt-swa-\(vars.testRunID)"
    location = "eastus2"
    resourceGroupName = rg.res.name
    sku = new staticsite.StaticSiteSKU {
      name = "Free"
      tier = "Free"
    }
    // Update: no more per-PR staging environments.
    stagingEnvironmentPolicy = "Disabled"
    // Update: the repository can no longer change routing and auth.
    allowConfigFileUpdates = false
    buildProperties = new staticsite.StaticSiteBuildProperties {
      appLocation = "/"
      outputLocation = "dist"
      skipGithubActionWorkflowGeneration = true
    }
  }
}
