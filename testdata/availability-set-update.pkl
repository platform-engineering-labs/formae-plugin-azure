amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/compute/availabilityset.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "availability-set-test-rg"
  name = "formae-plugin-sdk-test-avset-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new availabilityset.AvailabilitySet {
    label = "plugin-sdk-test-availability-set"
    name = "formae-plugin-sdk-test-avset-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    sku = new availabilityset.AvailabilitySetSku {
      name = "Aligned"
    }
    // Fault/update domain counts are immutable (createOnly) — unchanged here so
    // the fixture exercises an in-place PATCH, not a replace.
    platformFaultDomainCount = 2
    platformUpdateDomainCount = 5
    // Update: add tags
    tags = new Listing {
      new azure.Tag { key = "Environment"; value = "updated" }
    }
  }
}
