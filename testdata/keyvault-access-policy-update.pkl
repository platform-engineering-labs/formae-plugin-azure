amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/managedidentity/userassignedidentity.pkl"
import "@azure/keyvault/vault.pkl"
import "@azure/keyvault/accesspolicy.pkl"
import "vars.pkl"

local azureTenantId = "35412a0c-6726-4fc9-98ef-6e91adcb8d0e"

local rg = new resourcegroup.ResourceGroup {
  label = "kv-ap-test-rg"
  name = "formae-plugin-sdk-test-kv-ap-rg-\(vars.testRunID)"
  location = "eastus"
}

local vaultSku = new vault.VaultSKU {
  family = "A"
  name = "standard"
}

// enableRbacAuthorization MUST be false here. RBAC mode bypasses vault access
// policies entirely, so a policy written against an RBAC vault is stored, grants
// nothing, and the other Key Vault fixtures' `= true` cannot be copied.
//
// The vault name keeps the `fpsdt-kv-` prefix so clean-environment.sh purges it:
// a soft-deleted vault holds its name for the retention period.
local kv = new vault.Vault {
  label = "kv-ap-test-kv"
  name = "fpsdt-kv-ap-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  tenantId = azureTenantId
  sku = vaultSku
  enableSoftDelete = true
  softDeleteRetentionInDays = 7
  enableRbacAuthorization = false
}

// A user-assigned identity gives the policy a real AAD object id in this tenant
// without depending on who is running the test.
local grantee = new userassignedidentity.UserAssignedIdentity {
  label = "kv-ap-test-grantee"
  name = "formae-plugin-sdk-test-kv-ap-id-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
}

forma {
  vars.stack

  vars.target

  rg
  kv
  grantee

  new accesspolicy.AccessPolicy {
    label = "plugin-sdk-test-kv-access-policy"
    resourceGroupName = rg.res.name
    vaultName = kv.res.name
    tenantId = azureTenantId
    objectId = grantee.res.principalId
    // Update: narrow the key permissions and drop the secret category entirely.
    // Shrinking is the interesting case - ARM's `add` operation merges permission
    // arrays into an existing entry, so the handler removes the entry before
    // re-adding it, which is what makes a dropped permission actually disappear.
    permissions = new accesspolicy.Permissions {
      keys = new Listing { "get" }
      certificates = new Listing { "get"; "list" }
    }
  }
}
