amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/dataprotection/resourceguard.pkl" as guard
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "guard-test-rg"
  name = "formae-plugin-sdk-test-guard-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new guard.ResourceGuard {
    label = "plugin-sdk-test-resource-guard"
    name = "fpsdt-guard-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    // Update: exclude policy deletion instead of backup-config writes. Kept to a
    // single entry in both fixtures because ARM does not promise to preserve the
    // order of this list.
    vaultCriticalOperationExclusionList = new Listing {
      "Microsoft.RecoveryServices/vaults/backupPolicies/delete"
    }
  }
}
