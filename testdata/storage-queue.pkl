amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/storage/storageaccount.pkl"
import "@azure/storage/queue.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "storage-queue-test-rg"
  name = "formae-plugin-sdk-test-sq-rg-\(vars.testRunID)"
  location = "eastus"
}

local saSku = new storageaccount.StorageAccountSKU {
  name = "Standard_LRS"
}

local sa = new storageaccount.StorageAccount {
  label = "storage-queue-test-sa"
  name = "fpsdtsq\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = saSku
  kind = "StorageV2"
}

forma {
  vars.stack

  vars.target

  rg

  sa

  new queue.Queue {
    label = "plugin-sdk-test-storage-queue"
    name = "formae-plugin-sdk-test-queue-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    storageAccountName = sa.res.name
    metadata = new Listing {
      new azure.Tag { key = "purpose"; value = "conformance" }
    }
  }
}
