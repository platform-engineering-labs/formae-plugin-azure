amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/storage/storageaccount.pkl"
import "@azure/web/serviceplan.pkl"
import "@azure/web/functionapp.pkl"

import "vars.pkl"

// A Linux Python function app on a dedicated Basic B1 plan.
//
// Storage is wired with the IDENTITY-based connection form
// (`AzureWebJobsStorage__accountName` + `__credential = managedidentity`) rather
// than a connection string: formae cannot resolve storage account keys, and this
// keeps a secret out of the fixture entirely. The app's system-assigned identity
// still needs "Storage Blob Data Owner" on the account before functions would
// actually run — the site itself is created either way, which is what the CRUD
// lifecycle exercises.
//
// A dedicated plan rather than Consumption (Y1) on purpose: Consumption validates
// the storage connection at create time and needs a content share, both of which
// need a real key.
//
// siteConfig fields are all spelled out for the same reason as in web-app.pkl —
// `hasProviderDefault` is not honoured on fields of a nested class, and Azure fills
// every one of them in. functionAppScaleLimit comes back as 0 on a dedicated plan.

local rg = new resourcegroup.ResourceGroup {
  label = "functionapp-test-rg"
  name = "formae-plugin-sdk-test-fa-rg-\(vars.testRunID)"
  location = "eastus"
}

local sa = new storageaccount.StorageAccount {
  label = "functionapp-test-sa"
  name = "fpsdtfa\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new storageaccount.StorageAccountSKU { name = "Standard_LRS" }
  kind = "StorageV2"
}

local plan = new serviceplan.ServicePlan {
  label = "functionapp-test-plan"
  name = "fpsdt-fa-plan-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  kind = "linux"
  reserved = true
  sku = new serviceplan.ServicePlanSKU {
    name = "B1"
    tier = "Basic"
    capacity = 1
  }
}

forma {
  vars.stack

  vars.target

  rg
  sa
  plan

  new functionapp.FunctionApp {
    label = "plugin-sdk-test-function-app"
    name = "fpsdt-fa-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    serverFarmId = plan.res.id
    kind = "functionapp,linux"
    httpsOnly = true
    siteConfig = new functionapp.FunctionSiteConfig {
      linuxFxVersion = "PYTHON|3.12"
      netFrameworkVersion = "v4.0"
      alwaysOn = true
      ftpsState = "FtpsOnly"
      minTlsVersion = "1.2"
      http20Enabled = true
      functionAppScaleLimit = 0
    }
    appSettings = new Listing {
      new functionapp.AppSetting { name = "FUNCTIONS_EXTENSION_VERSION"; value = "~4" }
      new functionapp.AppSetting { name = "FUNCTIONS_WORKER_RUNTIME"; value = "python" }
      new functionapp.AppSetting { name = "AzureWebJobsStorage__accountName"; value = sa.res.name }
      new functionapp.AppSetting { name = "AzureWebJobsStorage__credential"; value = "managedidentity" }
    }
    identity = new functionapp.FunctionAppIdentity {
      type = "SystemAssigned"
    }
  }
}
