amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/operationalinsights/workspace.pkl"
import "@azure/operationalinsights/loganalyticsdatasourcewindowsperfcounter.pkl" as perfcounter
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "lawpc-test-rg"
  name = "formae-plugin-sdk-test-lawpc-rg-\(vars.testRunID)"
  location = "eastus"
}

// 30-day retention is what the PerGB2018 base price includes; the 1 GB daily cap
// bounds ingestion. Destroy soft-deletes the workspace for 14 days, hence the
// run-ID suffix.
local workspaceRes = new workspace.Workspace {
  label = "lawpc-test-law"
  name = "fpsdt-lawpc-law-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new workspace.SKU { name = "PerGB2018" }
  retentionInDays = 30
  dailyQuotaGb = 1
  publicNetworkAccessForIngestion = "Enabled"
  publicNetworkAccessForQuery = "Enabled"
}

forma {
  vars.stack

  vars.target

  rg

  workspaceRes

  // The data source is free and ingests nothing here: it configures the legacy
  // Log Analytics agent, and no agent reports to this workspace. `_Total` keeps
  // the counter to one series rather than one per logical processor.
  new perfcounter.DataSourceWindowsPerformanceCounter {
    label = "plugin-sdk-test-datasource-windows-perf-counter"
    name = "fpsdt-lawpc-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    workspaceName = workspaceRes.res.name
    objectName = "Processor"
    instanceName = "_Total"
    counterName = "% Processor Time"
    intervalSeconds = 60
  }
}
