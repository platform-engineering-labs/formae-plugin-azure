amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/network/publicipprefix.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "public-ip-prefix-test-rg"
  name = "formae-plugin-sdk-test-pipp-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new publicipprefix.PublicIPPrefix {
    label = "plugin-sdk-test-public-ip-prefix"
    name = "formae-plugin-sdk-test-pipp-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    sku = new publicipprefix.PublicIPPrefixSku {
      name = "Standard"
      tier = "Regional"
    }
    // /31 = 2 addresses, the smallest billable prefix.
    prefixLength = 31
    publicIPAddressVersion = "IPv4"
    // Update: add tags (everything else on a prefix is createOnly)
    tags = new Listing {
      new azure.Tag { key = "Environment"; value = "updated" }
    }
  }
}
