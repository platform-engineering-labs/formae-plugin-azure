amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/network/applicationsecuritygroup.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "application-security-group-test-rg"
  name = "formae-plugin-sdk-test-asg-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new applicationsecuritygroup.ApplicationSecurityGroup {
    label = "plugin-sdk-test-application-security-group"
    name = "formae-plugin-sdk-test-asg-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
  }
}
