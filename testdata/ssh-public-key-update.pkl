amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/compute/sshpublickey.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "ssh-public-key-test-rg"
  name = "formae-plugin-sdk-test-sshkey-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new sshpublickey.SshPublicKey {
    label = "plugin-sdk-test-ssh-public-key"
    name = "formae-plugin-sdk-test-sshkey-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    // Throwaway 2048-bit RSA public key generated for conformance testing only;
    // the matching private key was never retained.
    publicKey = "ssh-rsa  formae-conformance"
    // Update: add tags (the key material itself is unchanged)
    tags = new Listing {
      new azure.Tag { key = "Environment"; value = "updated" }
    }
  }
}
