amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/network/networkmanager.pkl" as netmanager
import "@azure/network/networkmanagernetworkgroup.pkl" as networkgroup
import "@azure/network/networkmanagerconnectivityconfiguration.pkl" as connectivity
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "nmcc-test-rg"
  name = "formae-plugin-sdk-test-nmcc-rg-\(vars.testRunID)"
  location = "eastus"
}

local managerScopes = new netmanager.NetworkManagerScopes {
  subscriptions {
    "/subscriptions/\(vars.subscriptionId)"
  }
}

// Connectivity is the scope access a connectivity configuration needs; ARM
// rejects the configuration if the manager does not list it.
local manager = new netmanager.NetworkManager {
  label = "nmcc-test-manager"
  name = "fpsdt-nmcc-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  networkManagerScopeAccesses {
    "Connectivity"
  }
  networkManagerScopes = managerScopes
}

local group = new networkgroup.NetworkManagerNetworkGroup {
  label = "nmcc-test-group"
  name = "conformance-group"
  resourceGroupName = rg.res.name
  networkManagerName = manager.res.name
}

forma {
  vars.stack

  vars.target

  rg
  manager
  group

  // Mesh with one network group is the simplest valid configuration: no hub is
  // needed, and an empty group is enough for ARM to accept it.
  //
  // The configuration is left UNCOMMITTED. Commits go through
  // networkManagerCommits, which this plugin does not model, and a committed
  // configuration cannot be deleted — leaving it uncommitted is what keeps the
  // fixture tearable-down.
  new connectivity.NetworkManagerConnectivityConfiguration {
    label = "plugin-sdk-test-network-manager-connectivity-configuration"
    name = "conformance-connectivity"
    resourceGroupName = rg.res.name
    networkManagerName = manager.res.name
    connectivityTopology = "Mesh"
    appliesToGroups {
      new connectivity.ConnectivityGroupItem {
        networkGroupId = group.res.id
        groupConnectivity = "None"
        isGlobal = "False"
      }
    }
    description = "Conformance connectivity configuration"
  }
}
