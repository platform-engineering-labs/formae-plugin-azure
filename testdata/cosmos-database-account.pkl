amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/documentdb/databaseaccount.pkl" as cosmos
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "cosmos-test-rg"
  name = "formae-plugin-sdk-test-cosmos-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // Single-region, Session consistency: the cheapest and fastest account Cosmos
  // will provision. enableFreeTier is left off — only one free-tier account is
  // allowed per subscription, so it would collide across runs.
  new cosmos.DatabaseAccount {
    label = "plugin-sdk-test-cosmos"
    name = "fpsdt-cosmos-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    kind = "GlobalDocumentDB"
    geoLocations = new Listing {
      new cosmos.GeoLocation {
        locationName = "eastus"
        failoverPriority = 0
        isZoneRedundant = false
      }
    }
    consistencyPolicy = new cosmos.ConsistencyPolicy {
      defaultConsistencyLevel = "Session"
    }
    publicNetworkAccess = "Enabled"
  }
}
