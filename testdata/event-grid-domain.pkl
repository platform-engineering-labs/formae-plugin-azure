amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/eventgrid/domain.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "event-grid-domain-test-rg"
  name = "formae-plugin-sdk-test-egd-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  new domain.Domain {
    label = "plugin-sdk-test-event-grid-domain"
    name = "fpsdt-egd-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    inputSchema = "EventGridSchema"
    publicNetworkAccess = "Enabled"
    autoCreateTopicWithFirstSubscription = true
    autoDeleteTopicWithLastSubscription = false
  }
}
