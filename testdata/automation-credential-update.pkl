amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/automation/automationaccount.pkl"
import "@azure/automation/automationcredential.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "aacred-test-rg"
  name = "formae-plugin-sdk-test-aacred-rg-\(vars.testRunID)"
  location = "eastus"
}

local acct = new automationaccount.AutomationAccount {
  label = "aacred-test-account"
  name = "fpsdt-aacred-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  skuName = "Free"
}

forma {
  vars.stack

  vars.target

  rg
  acct

  // The password is write-only by ARM's own design — CredentialProperties has no
  // password field, so Get can never return one — and is wrapped opaque so the
  // plaintext is stored only as a hash. It is a throwaway value: this credential
  // authenticates to nothing, and the account it lives in is torn down with the
  // resource group.
  new automationcredential.AutomationCredential {
    label = "plugin-sdk-test-automation-credential"
    name = "fpsdt-credential-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    automationAccountName = acct.res.name
    // Update: CredentialUpdateProperties carries the username, the password and
    // the description, so all three are mutable. Only the comparable fields are
    // changed here: a rotated password could not be verified by a read, because
    // ARM never returns it.
    userName = "conformance-user-updated"
    password = formae.value("Conformance-Placeholder-1").opaque
    description = "Conformance credential updated"
  }
}
