amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementapi.pkl" as apimapi
import "@azure/apimanagement/apimanagementapioperation.pkl" as apimop
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-op-test-rg"
  name = "formae-plugin-sdk-test-apimop-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing.
local svc = new apim.Service {
  label = "apim-op-test-service"
  name = "fpsdt-apimop-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

// Declared explicitly rather than imported: an import makes ARM synthesize one
// operation per path in the document, and those then look like unmanaged
// children of this API.
local api = new apimapi.Api {
  label = "apim-op-test-api"
  name = "conformance-api"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  displayName = "Conformance API"
  path = "conformance"
  protocols = new Listing { "https" }
  serviceUrl = "https://echo.platform.engineering"
}

forma {
  vars.stack

  vars.target

  rg
  svc
  api

  new apimop.ApiOperation {
    label = "plugin-sdk-test-apim-api-operation"
    name = "get-status"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    apiName = api.res.name
    displayName = "Get status"
    method = "GET"
    urlTemplate = "/status"
    description = "Health probe"
  }
}
