amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementapi.pkl" as apimapi
import "@azure/apimanagement/apimanagementproduct.pkl" as apimproduct
import "@azure/apimanagement/apimanagementproductapi.pkl" as apimproductapi
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-productapi-test-rg"
  name = "formae-plugin-sdk-test-apimproductapi-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing.
local svc = new apim.Service {
  label = "apim-productapi-test-service"
  name = "fpsdt-apimproductapi-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

// Declared explicitly rather than imported: an import makes ARM synthesize one
// operation per path in the document, and those then look like unmanaged
// children of this API.
local api = new apimapi.Api {
  label = "apim-productapi-test-api"
  name = "conformance-api"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  displayName = "Conformance API"
  path = "conformance"
  protocols = new Listing { "https" }
  serviceUrl = "https://echo.platform.engineering"
}

local product = new apimproduct.Product {
  label = "apim-productapi-test-product"
  name = "conformance-product"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  displayName = "Conformance Product v2"
  subscriptionRequired = false
  state = "published"
}

forma {
  vars.stack

  vars.target

  rg
  svc
  api
  product

  // Update: a link has no mutable field of its own — every one of the four
  // names is part of its identity — so what changes here is the product's
  // display name above. The link is re-PUT unchanged, which ARM accepts as
  // idempotent, and its native ID must not move.
  new apimproductapi.ProductApi {
    label = "plugin-sdk-test-apim-product-api"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    productName = product.res.name
    apiName = api.res.name
  }
}
