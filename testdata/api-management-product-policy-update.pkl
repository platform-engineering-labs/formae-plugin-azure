amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementproduct.pkl" as apimproduct
import "@azure/apimanagement/apimanagementproductpolicy.pkl" as apimproductpol
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-productpol-test-rg"
  name = "formae-plugin-sdk-test-apimproductpol-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing.
local svc = new apim.Service {
  label = "apim-productpol-test-service"
  name = "fpsdt-apimproductpol-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

local product = new apimproduct.Product {
  label = "apim-productpol-test-product"
  name = "conformance-product"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  displayName = "Conformance Product"
  subscriptionRequired = false
  state = "published"
}

forma {
  vars.stack

  vars.target

  rg
  svc
  product

  // Update: one added inbound policy. The whole document is re-PUT because a
  // policy has no PATCH verb.
  new apimproductpol.ProductPolicy {
    label = "plugin-sdk-test-apim-product-policy"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    productName = product.res.name
    format = "xml"
    value = """
      <policies>
        <inbound>
          <base />
          <set-header name="x-formae-conformance" exists-action="override">
            <value>updated</value>
          </set-header>
        </inbound>
        <backend>
          <base />
        </backend>
        <outbound>
          <base />
        </outbound>
        <on-error>
          <base />
        </on-error>
      </policies>
      """
  }
}
