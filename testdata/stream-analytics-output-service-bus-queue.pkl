amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/servicebus/servicebusnamespace.pkl" as sbnamespace
import "@azure/servicebus/servicebusqueue.pkl" as sbqueue
import "@azure/streamanalytics/streamanalyticsjob.pkl" as sajob
import "@azure/streamanalytics/streamanalyticsoutputservicebusqueue.pkl" as saoutput
import "vars.pkl"

// The datasource credential below is a placeholder, not a real key.
//
// ARM accepts any string here and never returns it (the field is writeOnly in the
// schema for exactly that reason), and Stream Analytics validates a datasource only
// when the job starts or when the separate Test operation is called. The job this
// fixture creates is never started, so no connection is ever attempted. There is
// also no way to obtain a real key from a forma: this plugin deliberately does not
// surface storage account keys or SAS policy keys as properties, since that would
// persist live credentials in resource state.

local rg = new resourcegroup.ResourceGroup {
  label = "asa-output-sbq-test-rg"
  name = "formae-plugin-sdk-test-asaosbq-rg-\(vars.testRunID)"
  location = "eastus"
}

local sbNamespace = new sbnamespace.Namespace {
  label = "asa-output-sbq-test-sb-ns"
  name = "fpsdt-asa-osbq-ns-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new sbnamespace.NamespaceSKU { name = "Standard" }
}

local queue = new sbqueue.Queue {
  label = "asa-output-sbq-test-sb-queue"
  name = "fpsdt-asa-osbq-q-\(vars.testRunID)"
  resourceGroupName = rg.res.name
  namespaceName = sbNamespace.res.name
}

// Provisioned stopped and left that way: Start/Stop is a separate ARM verb pair,
// and a running job bills streaming units per hour.
local job = new sajob.StreamingJob {
  label = "asa-output-sbq-test-job"
  name = "fpsdt-asa-osbq-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new sajob.StreamingJobSKU { name = "Standard" }
  jobType = "Cloud"
  compatibilityLevel = "1.2"
  dataLocale = "en-US"
  eventsLateArrivalMaxDelayInSeconds = 5
  eventsOutOfOrderMaxDelayInSeconds = 0
  eventsOutOfOrderPolicy = "Adjust"
  outputErrorPolicy = "Stop"
  transformation = new sajob.JobTransformation {
    name = "Transformation"
    query = "SELECT * INTO [asaoutput] FROM [asainput]"
    streamingUnits = 3
  }
}

forma {
  vars.stack

  vars.target

  rg
  sbNamespace
  queue
  job

  // RootManageSharedAccessKey is the policy every Service Bus namespace ships with;
  // it carries Send, which is what an output needs.
  new saoutput.OutputServiceBusQueue {
    label = "plugin-sdk-test-stream-analytics-output-service-bus-queue"
    name = "asaoutput"
    resourceGroupName = rg.res.name
    jobName = job.res.name
    serviceBusNamespace = sbNamespace.res.name
    queueName = queue.res.name
    sharedAccessPolicyName = "RootManageSharedAccessKey"
    sharedAccessPolicyKey = "Zm9ybWFlLWNvbmZvcm1hbmNlLXBsYWNlaG9sZGVyISE="
    propertyColumns = new Listing { "deviceId" }
    serialization = new saoutput.ServiceBusQueueOutputSerialization {
      type = "Json"
      encoding = "UTF8"
      format = "LineSeparated"
    }
  }
}
