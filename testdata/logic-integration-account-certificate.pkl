amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/logic/logicintegrationaccount.pkl" as logicaccount
import "@azure/logic/logicintegrationaccountcertificate.pkl" as logiccert
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "logiccrt-test-rg"
  name = "formae-plugin-sdk-test-logiccrt-rg-\(vars.testRunID)"
  location = "northeurope"
}

// northeurope: one Free integration account per region per subscription, and the
// other fixtures in this group each own a different one.
local iaccount = new logicaccount.IntegrationAccount {
  label = "logiccrt-test-account"
  name = "fpsdt-logiccrt-\(vars.testRunID)"
  location = "northeurope"
  resourceGroupName = rg.res.name
  skuName = "Basic"
}

forma {
  vars.stack

  vars.target

  rg
  iaccount

  // Free: a certificate is metadata on the parent account and is not billed
  // separately.
  //
  // The PUBLIC blob form. ARM's other form — a KeyVaultKeyReference naming a
  // private key — is not modelled: it needs a data-plane grant on the vault plus
  // an access policy for the integration account's identity, neither of which
  // this resource type can express.
  //
  // The value below is the base64 DER of a throwaway self-signed certificate
  // generated for this fixture (CN=formae-conformance-as2). Only the public half
  // is here; the private key was never kept. It is what an AS2 agreement would
  // use to verify a partner's signature.
  new logiccert.IntegrationAccountCertificate {
    label = "plugin-sdk-test-logic-integration-account-certificate"
    name = "conformance-as2-cert"
    resourceGroupName = rg.res.name
    integrationAccountName = iaccount.res.name
    publicCertificate = ""
  }
}
