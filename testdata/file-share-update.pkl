amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/storage/storageaccount.pkl"
import "@azure/storage/fileshare.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "file-share-test-rg"
  name = "formae-plugin-sdk-test-fs-rg-\(vars.testRunID)"
  location = "eastus"
}

local saSku = new storageaccount.StorageAccountSKU {
  name = "Standard_LRS"
}

local sa = new storageaccount.StorageAccount {
  label = "file-share-test-sa"
  name = "fpsdtfs\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = saSku
  kind = "StorageV2"
}

forma {
  vars.stack

  vars.target

  rg

  sa

  new fileshare.FileShare {
    label = "plugin-sdk-test-file-share"
    name = "formae-plugin-sdk-test-share-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    storageAccountName = sa.res.name
    // Update: grow the quota and move to the Hot tier
    shareQuota = 200
    accessTier = "Hot"
    // enabledProtocols is createOnly — unchanged so this stays an in-place update
    enabledProtocols = "SMB"
    metadata = new Listing {
      new azure.Tag { key = "purpose"; value = "conformance-updated" }
    }
  }
}
