amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/network/dnsresolverdomainlist.pkl" as domainlist
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "dnsdl-test-rg"
  name = "formae-plugin-sdk-test-dnsdl-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // Domains carry a trailing dot. A bare "." would match everything, which is how
  // a default-deny security rule is written.
  new domainlist.DnsResolverDomainList {
    label = "plugin-sdk-test-dns-resolver-domain-list"
    name = "formae-plugin-sdk-test-dnsdl-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    // Update: add a third domain AND retag. The domain list is genuinely updatable
    // (DomainListPatch nests it under "properties" correctly) and list growth does
    // register as a diff — the tag change is belt-and-braces.
    domains = new Listing {
      "malware.example.com."
      "phishing.example.com."
      "spam.example.com."
    }
    tags = new Listing {
      new azure.Tag { key = "env"; value = "conformance-updated" }
    }
  }
}
