amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementcertificate.pkl" as apimcert
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-cert-test-rg"
  name = "formae-plugin-sdk-test-apimcert-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing. Client
// certificates ARE available on Consumption.
local svc = new apim.Service {
  label = "apim-cert-test-service"
  name = "fpsdt-apimcert-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

// A throwaway self-signed PKCS#12, generated once and pinned here. ARM parses
// the blob on the way in — a malformed or expired certificate is rejected at
// [Create] — so it has to be a real one:
//
//   openssl req -x509 -newkey rsa:2048 -keyout k.pem -out c.pem -days 10950 \
//     -nodes -subj "/CN=conformance.formae.invalid/O=Platform Engineering Labs"
//   openssl pkcs12 -export -out c.pfx -inkey k.pem -in c.pem \
//     -passout pass:FormaeConformance1! -macalg sha1 \
//     -keypbe PBE-SHA1-3DES -certpbe PBE-SHA1-3DES
//   base64 -i c.pfx | tr -d '\n'
//
// The 3DES/SHA-1 PBE is deliberate: it is the classic PKCS#12 encoding every
// .NET version accepts, where OpenSSL 3's AES-256/PBKDF2 default is not
// universally readable. The subject is on a .invalid domain, so the
// certificate can never be mistaken for one that authenticates anything real,
// and it expires in 2056 so it does not silently start failing.
//
// The local is `certificateBlob`, not `data`: a fixture local must not share a
// name with a property of the class it is assigned to, or the reference
// resolves to the property instead and Pkl recurses until the stack overflows.
local certificateBlob = ""

forma {
  vars.stack

  vars.target

  rg
  svc

  // Both `data` and `password` are write-only — ARM validates the blob, stores
  // it and never returns either — so what the conformance verify phase compares
  // is `subject`, `thumbprint` and `expirationDate`, which ARM reads out of the
  // certificate itself.
  new apimcert.Certificate {
    label = "plugin-sdk-test-apim-certificate"
    name = "conformance-client-cert"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    data = certificateBlob
    password = "FormaeConformance1!"
  }
}
