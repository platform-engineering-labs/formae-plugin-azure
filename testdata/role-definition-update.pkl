amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/authorization/roledefinition.pkl" as roledefinition
import "vars.pkl"

// Role definitions live at a scope rather than in a resource group, so no group is
// created here. The subscription is both the definition's home and the only scope it
// may be assigned at.
local subscriptionScope = "/subscriptions/\(vars.subscriptionId)"

forma {
  vars.stack

  vars.target

  // Free: custom roles carry no charge. The run ID becomes the first field of the
  // GUID ARM requires as the role's name, so concurrent runs cannot collide.
  //
  // Read-only permissions only — a conformance role is never assigned to anyone, but
  // a role that could delete storage has no business existing on a shared
  // subscription.
  new roledefinition.RoleDefinition {
    label = "plugin-sdk-test-role-definition"
    name = "\(vars.testRunID)-0000-4000-8000-000000000000"
    scope = subscriptionScope
    roleName = "formae plugin sdk test reader \(vars.testRunID)"
    description = "conformance test custom role, revised"
    assignableScopes {
      subscriptionScope
    }
    permissions {
      new roledefinition.Permission {
        actions {
          "Microsoft.Storage/storageAccounts/read"
          "Microsoft.Resources/subscriptions/resourceGroups/read"
        }
      }
    }
  }
}
