amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/documentdb/databaseaccount.pkl" as cosmos
import "@azure/documentdb/cosmosmongodatabase.pkl" as mongodb
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "cosmos-mongodb-test-rg"
  name = "formae-plugin-sdk-test-cmongodb-rg-\(vars.testRunID)"
  location = "eastus"
}

// MongoDB wire protocol: kind = MongoDB. That is createOnly on the account, so a
// GlobalDocumentDB account can never hold Mongo databases.
local account = new cosmos.DatabaseAccount {
  label = "cosmos-mongodb-test-account"
  name = "fpsdt-cmongodb-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  kind = "MongoDB"
  geoLocations = new Listing {
    new cosmos.GeoLocation {
      locationName = "eastus"
      failoverPriority = 0
      isZoneRedundant = false
    }
  }
  consistencyPolicy = new cosmos.ConsistencyPolicy {
    defaultConsistencyLevel = "Session"
  }
}

forma {
  vars.stack

  vars.target

  rg

  account

  // Database-level shared throughput at the 400 RU/s floor. Both throughput fields
  // are createOnly, so the -replace fixture changes `name` instead.
  new mongodb.MongoDatabase {
    label = "plugin-sdk-test-cosmos-mongodb"
    name = "fpsdt-catalog-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    accountName = account.res.name
    throughput = 400
  }
}
