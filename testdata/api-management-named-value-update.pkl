amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementnamedvalue.pkl" as apimnv
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-namedvalue-test-rg"
  name = "formae-plugin-sdk-test-apimnv-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing. Named values ARE
// available on Consumption.
local svc = new apim.Service {
  label = "apim-namedvalue-test-service"
  name = "fpsdt-apimnv-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

forma {
  vars.stack

  vars.target

  rg
  svc

  // Update: the value and the filter labels change. `secret` stays false —
  // flipping it to true would make ARM stop returning anything about the value
  // at all, which is a different resource shape rather than an edit.
  new apimnv.NamedValue {
    label = "plugin-sdk-test-apim-named-value"
    name = "conformance-backend-url"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    displayName = "conformance-backend-url"
    value = "https://echo2.platform.engineering"
    secret = false
    tags = new Listing { "conformance"; "updated" }
  }
}
