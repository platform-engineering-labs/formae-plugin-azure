amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/authorization/policydefinition.pkl" as policydefinition
import "vars.pkl"

// Policy definitions live at subscription scope, so no resource group is created.
forma {
  vars.stack

  vars.target

  // Free: definitions and their evaluation carry no charge. The effect is `audit`
  // rather than `deny` — a conformance definition is never assigned to anything, but
  // an unassigned deny rule on a shared subscription is not worth the risk.
  //
  // policyRule is compact JSON with sorted keys, which is the form the provider
  // canonicalises ARM's answer to.
  new policydefinition.PolicyDefinition {
    label = "plugin-sdk-test-policy-definition"
    name = "formae-plugin-sdk-test-pd-\(vars.testRunID)"
    displayName = "formae plugin sdk test audit \(vars.testRunID)"
    description = "conformance test policy definition"
    mode = "Indexed"
    policyRule = #"{"if":{"field":"location","notEquals":"eastus"},"then":{"effect":"audit"}}"#
  }
}
