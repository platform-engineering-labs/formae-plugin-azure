amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/logic/logicintegrationaccount.pkl" as logicaccount
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "logicia-test-rg"
  name = "formae-plugin-sdk-test-logicia-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // Update: tags only. `skuName` is deliberately unchanged - the two paid
  // tiers bill per hour, so exercising a SKU change would put a Standard
  // account on the shared subscription for the length of the run.
  new logicaccount.IntegrationAccount {
    label = "plugin-sdk-test-logic-integration-account"
    name = "fpsdt-logicia-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    skuName = "Basic"
    tags = new Listing {
      new azure.Tag { key = "purpose"; value = "conformance" }
      new azure.Tag { key = "phase"; value = "update" }
    }
  }
}
