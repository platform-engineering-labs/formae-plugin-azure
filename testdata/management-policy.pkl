amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/storage/storageaccount.pkl"
import "@azure/storage/managementpolicy.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "mp-test-rg"
  name = "formae-plugin-sdk-test-mp-rg-\(vars.testRunID)"
  location = "eastus"
}

local saSku = new storageaccount.StorageAccountSKU {
  name = "Standard_LRS"
}

// Lifecycle management needs a general-purpose v2 account; it is not supported on
// the legacy Storage kind.
local sa = new storageaccount.StorageAccount {
  label = "mp-test-sa"
  name = "fpsdtmp\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = saSku
  kind = "StorageV2"
}

forma {
  vars.stack

  vars.target

  rg
  sa

  // Singleton child: ARM always names the policy `default`, so this resource has
  // no name property — one policy per storage account.
  new managementpolicy.ManagementPolicy {
    label = "plugin-sdk-test-mp"
    resourceGroupName = rg.res.name
    storageAccountName = sa.res.name
    rules = new Listing {
      new managementpolicy.Rule {
        name = "expire-logs"
        enabled = true
        definition = new managementpolicy.RuleDefinition {
          actions = new managementpolicy.RuleActions {
            baseBlob = new managementpolicy.BaseBlobActions {
              tierToCool = new managementpolicy.DaysAfterModification { daysAfterModificationGreaterThan = 30 }
              deleteAfter = new managementpolicy.DaysAfterModification { daysAfterModificationGreaterThan = 365 }
            }
          }
          filters = new managementpolicy.RuleFilters {
            blobTypes = new Listing { "blockBlob" }
            prefixMatch = new Listing { "logs/" }
          }
        }
      }
    }
  }
}
