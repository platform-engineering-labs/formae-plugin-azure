amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/recoveryservices/recoveryservicesvault.pkl" as rsv
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "rsv-test-rg"
  name = "formae-plugin-sdk-test-rsv-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // softDeleteState is pinned Disabled rather than left to the service: the
  // default is Enabled, and a vault with soft delete on keeps deleted backup
  // items for their retention window and refuses its own delete until then.
  new rsv.Vault {
    label = "plugin-sdk-test-rsv"
    name = "fpsdt-rsv-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    skuName = "Standard"
    softDeleteState = "Disabled"
    alertsForAllJobFailures = "Enabled"
  }
}
