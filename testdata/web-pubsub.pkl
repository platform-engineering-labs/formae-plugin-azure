amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/signalrservice/webpubsub.pkl" as wps
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "wps-test-rg"
  name = "formae-plugin-sdk-test-wps-rg-\(vars.testRunID)"
  location = "eastus"
}

forma {
  vars.stack

  vars.target

  rg

  // Standard_S1 rather than Free_F1: the free tier allows one instance per
  // subscription per region, which would collide across conformance runs.
  new wps.WebPubSub {
    label = "plugin-sdk-test-wps"
    name = "fpsdt-wps-\(vars.testRunID)"
    location = "eastus"
    resourceGroupName = rg.res.name
    sku = new wps.SKU {
      name = "Standard_S1"
      capacity = 1
    }
    kind = "WebPubSub"
    disableAadAuth = false
    publicNetworkAccess = "Enabled"
  }
}
