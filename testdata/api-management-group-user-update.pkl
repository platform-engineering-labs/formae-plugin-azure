amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/apimanagement/apimanagementservice.pkl" as apim
import "@azure/apimanagement/apimanagementgroup.pkl" as apimgroup
import "@azure/apimanagement/apimanagementuser.pkl" as apimuser
import "@azure/apimanagement/apimanagementgroupuser.pkl" as apimgroupuser
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "apim-groupuser-test-rg"
  name = "formae-plugin-sdk-test-apimgroupuser-rg-\(vars.testRunID)"
  location = "eastus"
}

// Consumption is the only tier a conformance run can use: every dedicated tier
// takes 30 to 45 minutes to provision, which outlives the CI credential's
// lifetime. An idle Consumption instance also costs nothing.
//
// NOTE: this fixture cannot pass on Consumption — it needs BOTH a group and a
// user, and the tier has neither store. See api-management-group.pkl and
// api-management-user.pkl for the doc references. Handler, schema and test are
// complete; the SKU is deliberately not changed.
local svc = new apim.Service {
  label = "apim-groupuser-test-service"
  name = "fpsdt-apimgroupuser-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  publisherEmail = "conformance@platform.engineering"
  publisherName = "Platform Engineering Labs"
  skuName = "Consumption"
  skuCapacity = 0
}

local developerGroup = new apimgroup.Group {
  label = "apim-groupuser-test-group"
  name = "conformance-partners"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  displayName = "Conformance Partners v2"
  groupType = "custom"
}

local developer = new apimuser.User {
  label = "apim-groupuser-test-user"
  name = "conformance-user"
  resourceGroupName = rg.res.name
  serviceName = svc.res.name
  email = "conformance-groupuser@platform.engineering"
  firstName = "Conformance"
  lastName = "User"
  state = "active"
}

forma {
  vars.stack

  vars.target

  rg
  svc
  developerGroup
  developer

  // Update: like every link, this one has no mutable field of its own — all
  // four names are part of its identity — so what changes is the group's
  // display name above. The membership is re-PUT unchanged and its native ID
  // must not move.
  new apimgroupuser.GroupUser {
    label = "plugin-sdk-test-apim-group-user"
    resourceGroupName = rg.res.name
    serviceName = svc.res.name
    groupName = developerGroup.res.name
    userName = developer.res.name
  }
}
