amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/sql/server.pkl"
import "@azure/sql/elasticpool.pkl"
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "sql-elastic-pool-test-rg"
  name = "formae-plugin-sdk-test-sql-pool-rg-\(vars.testRunID)"
  location = "westus2"
}

local srv = new server.Server {
  label = "plugin-sdk-test-sql-pool-server"
  name = "fpsdt-sqlpool-\(vars.testRunID)"
  location = "westus2"
  resourceGroupName = rg.res.name
  administratorLogin = "sqladmin"
  administratorLoginPassword = "T3stP@ssw0rd!"
  version = "12.0"
  minimalTlsVersion = "1.2"
}

forma {
  vars.stack

  vars.target

  rg

  srv

  new elasticpool.ElasticPool {
    label = "plugin-sdk-test-sql-elastic-pool"
    name = "fpsdt-pool-\(vars.testRunID)"
    location = "westus2"
    resourceGroupName = rg.res.name
    serverName = srv.res.name
    // StandardPool with 50 pool eDTUs; maxCapacity per database may not exceed
    // the pool capacity.
    sku = new elasticpool.SKU {
      name = "StandardPool"
      tier = "Standard"
      capacity = 50
    }
    // Update: raise the per-database ceiling 20 -> 50 eDTUs. An in-place resize,
    // so the NativeID must stay the same (a replace would drop member databases).
    perDatabaseSettings = new elasticpool.PerDatabaseSettings {
      minCapacity = 0
      maxCapacity = 50
    }
  }
}
