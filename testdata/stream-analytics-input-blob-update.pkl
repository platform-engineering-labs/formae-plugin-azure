amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/storage/storageaccount.pkl"
import "@azure/storage/blobcontainer.pkl"
import "@azure/streamanalytics/streamanalyticsjob.pkl" as sajob
import "@azure/streamanalytics/streamanalyticsinputblob.pkl" as sainput
import "vars.pkl"

// The datasource credential below is a placeholder, not a real key.
//
// ARM accepts any string here and never returns it (the field is writeOnly in the
// schema for exactly that reason), and Stream Analytics validates a datasource only
// when the job starts or when the separate Test operation is called. The job this
// fixture creates is never started, so no connection is ever attempted. There is
// also no way to obtain a real key from a forma: this plugin deliberately does not
// surface storage account keys or SAS policy keys as properties, since that would
// persist live credentials in resource state.

local rg = new resourcegroup.ResourceGroup {
  label = "asa-input-blob-test-rg"
  name = "formae-plugin-sdk-test-asaib-rg-\(vars.testRunID)"
  location = "eastus"
}

local sa = new storageaccount.StorageAccount {
  label = "asa-input-blob-test-sa"
  name = "fpsdtasaib\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new storageaccount.StorageAccountSKU { name = "Standard_LRS" }
  kind = "StorageV2"
}

local blobContainer = new blobcontainer.BlobContainer {
  label = "asa-input-blob-test-container"
  name = "fpsdt-asa-ib-\(vars.testRunID)"
  resourceGroupName = rg.res.name
  storageAccountName = sa.res.name
  publicAccess = "None"
}

// Provisioned stopped and left that way: Start/Stop is a separate ARM verb pair,
// and a running job bills streaming units per hour.
local job = new sajob.StreamingJob {
  label = "asa-input-blob-test-job"
  name = "fpsdt-asa-ib-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  sku = new sajob.StreamingJobSKU { name = "Standard" }
  jobType = "Cloud"
  compatibilityLevel = "1.2"
  dataLocale = "en-US"
  eventsLateArrivalMaxDelayInSeconds = 5
  eventsOutOfOrderMaxDelayInSeconds = 0
  eventsOutOfOrderPolicy = "Adjust"
  outputErrorPolicy = "Stop"
  transformation = new sajob.JobTransformation {
    name = "Transformation"
    query = "SELECT * INTO [asaoutput] FROM [asainput]"
    streamingUnits = 3
  }
}

forma {
  vars.stack

  vars.target

  rg
  sa
  blobContainer
  job

  new sainput.InputBlob {
    label = "plugin-sdk-test-stream-analytics-input-blob"
    name = "asainput"
    resourceGroupName = rg.res.name
    jobName = job.res.name
    storageAccountName = sa.res.name
    storageAccountKey = "Zm9ybWFlLXBsdWdpbi1zZGstdGVzdC1wbGFjZWhvbGRlci1zdG9yYWdlLWFjY291bnQta2V5LW5vdC1hLXNlYw=="
    container = blobContainer.res.name
    // Update: narrow the input to an "in/" prefix. In-place PATCH.
    pathPattern = "in/{date}/{time}"
    dateFormat = "yyyy/MM/dd"
    timeFormat = "HH"
    serialization = new sainput.InputSerialization {
      type = "Json"
      encoding = "UTF8"
    }
  }
}
