amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/dataprotection/backupvault.pkl" as bv
import "@azure/dataprotection/dataprotectionbackuppolicykubernetescluster.pkl" as bp
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "bp-aks-test-rg"
  name = "formae-plugin-sdk-test-bp-aks-rg-\(vars.testRunID)"
  location = "eastus"
}

// The cheapest vault that can hold a policy: one LocallyRedundant VaultStore and
// soft delete off, so the destroy phase is clean. A policy is a record inside the
// vault and adds nothing to its cost.
local backupVault = new bv.BackupVault {
  label = "bp-aks-test-vault"
  name = "fpsdt-bpaks-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  storageSettings = new Listing {
    new bv.StorageSetting {
      datastoreType = "VaultStore"
      type = "LocallyRedundant"
    }
  }
  softDeleteState = "Off"
}

forma {
  vars.stack

  vars.target

  rg

  backupVault

  // No AKS cluster is created or needed: an AKS policy is a record.
  // Update: keep operational-tier snapshots for 14 days instead of 7.
  new bp.BackupPolicyKubernetesCluster {
    label = "plugin-sdk-test-bp-aks"
    name = "fpsdt-bpaks-pol-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    vaultName = backupVault.res.name
    backupRules = new Listing {
      new bp.BackupRule {
        name = "BackupHourly"
        backupType = "Incremental"
        datastoreType = "OperationalStore"
        repeatingTimeIntervals = new Listing { "R/2024-01-01T09:00:00+00:00/PT4H" }
        taggingCriteria = new Listing {
          new bp.TaggingCriterion {
            tagName = "Default"
            isDefault = true
            taggingPriority = 99
          }
        }
      }
    }
    retentionRules = new Listing {
      new bp.RetentionRule {
        name = "Default"
        isDefault = true
        lifecycles = new Listing {
          new bp.RetentionLifecycle {
            sourceDatastoreType = "OperationalStore"
            deleteAfterDuration = "P14D"
          }
        }
      }
    }
  }
}
