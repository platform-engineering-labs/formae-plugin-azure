amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/dataprotection/backupvault.pkl" as bv
import "@azure/dataprotection/dataprotectionbackuppolicyblobstorage.pkl" as bp
import "vars.pkl"

local rg = new resourcegroup.ResourceGroup {
  label = "bp-blob-test-rg"
  name = "formae-plugin-sdk-test-bp-blob-rg-\(vars.testRunID)"
  location = "eastus"
}

// The cheapest vault that can hold a policy: one LocallyRedundant VaultStore and
// soft delete off, so the destroy phase is clean. A policy is a record inside the
// vault and adds nothing to its cost.
local backupVault = new bv.BackupVault {
  label = "bp-blob-test-vault"
  name = "fpsdt-bpblob-\(vars.testRunID)"
  location = "eastus"
  resourceGroupName = rg.res.name
  storageSettings = new Listing {
    new bv.StorageSetting {
      datastoreType = "VaultStore"
      type = "LocallyRedundant"
    }
  }
  softDeleteState = "Off"
}

forma {
  vars.stack

  vars.target

  rg

  backupVault

  // Operational-tier blob protection. Update: stretch the point-in-time restore
  // window from 30 to 60 days — a full PUT, since the policy API has no PATCH.
  new bp.BackupPolicyBlobStorage {
    label = "plugin-sdk-test-bp-blob"
    name = "fpsdt-bpblob-pol-\(vars.testRunID)"
    resourceGroupName = rg.res.name
    vaultName = backupVault.res.name
    retentionRules = new Listing {
      new bp.RetentionRule {
        name = "Default"
        isDefault = true
        lifecycles = new Listing {
          new bp.RetentionLifecycle {
            sourceDatastoreType = "OperationalStore"
            deleteAfterDuration = "P60D"
          }
        }
      }
    }
  }
}
