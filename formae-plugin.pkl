name = "azure"
version = "0.1.12"
namespace = "AZURE"
summary = "Azure resource plugin (ARM-based)"
description = "Azure Resource Manager (ARM) plugin for Formae"
category = "cloud"
license = "FSL-1.1-ALv2"
minFormaeVersion = "0.89.0"

// A cloud provider region cannot be deleted out of band, so its targets
// must never be reaped no matter how long they stay unreachable.
defaultReap {
  Kind = "never"
}

output {
  renderer = new JsonRenderer {}
}
